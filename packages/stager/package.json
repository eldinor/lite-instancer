{
  "name": "@litools/stager",
  "version": "0.1.0",
  "description": "Application-stage lifecycle, cancellation, transitions, and resource ownership.",
  "homepage": "https://github.com/eldinor/lite-instancer/tree/main/packages/stager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eldinor/lite-instancer.git",
    "directory": "packages/stager"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./babylon": {
      "types": "./dist/babylon.d.ts",
      "import": "./dist/babylon.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "examples:dev": "vite --config vite.examples.config.ts --host 0.0.0.0",
    "examples:build": "vite build --config vite.examples.config.ts",
    "examples:preview": "vite preview --config vite.examples.config.ts --host 0.0.0.0",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run examples:build"
  },
  "peerDependencies": {
    "@babylonjs/lite": "^1.14.0"
  },
  "devDependencies": {
    "@babylonjs/lite": "1.14.0",
    "@types/node": "^26.1.1",
    "@webgpu/types": "^0.1.71",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
